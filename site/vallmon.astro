  <script>
    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));

    function showTab(id: string, updateHash = true) {
      const target = `panel-${id}`;
      panels.forEach((panel) => {
        panel.hidden = panel.id !== target;
      });
      tabButtons.forEach((button) => {
        button.setAttribute("aria-selected", String(button.dataset.tab === id));
      });
      if (updateHash) {
        history.replaceState(null, "", `#${id}`);
      }
      if (id === "holdings") {
        loadHoldings();
      }
    }

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => showTab(button.dataset.tab ?? "monitor"));
    });

    document.querySelectorAll<HTMLElement>("[data-jump]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        showTab(link.dataset.jump ?? "monitor");
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });

    // Links inside the rendered report prose switch tabs instead of jumping to
    // a hidden panel (for example "Recorded runs ... in backtest.md").
    document.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        'a[href="#backtests"], a[href="#method"]',
      );
      if (!link) return;
      event.preventDefault();
      showTab(link.getAttribute("href")?.slice(1) ?? "monitor");
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    // Static tables: reorder the existing <tr> elements. The cells already carry
    // their colours, arrows and flags, so sorting never re-renders them. Pinned
    // rows (the "Total" line) always stay at the bottom, and dashes always sink.
    function sortableCellValue(cell: HTMLTableCellElement): number | string | null {
      const explicit = cell.dataset.value;
      if (explicit !== undefined) return explicit === "" ? null : Number(explicit);
      const text = (cell.textContent ?? "").replace(/[▲▼•↕]/g, "").trim();
      if (text === "" || text === "—" || text === "–") return null;
      const numeric = text.replace(/,/g, "").match(/^[-+]?\d+(?:\.\d+)?%?$/);
      return numeric ? Number(numeric[0].replace("%", "")) : text.toLowerCase();
    }

    function compareValues(left: number | string, right: number | string): number {
      if (typeof left === "number" && typeof right === "number") return left - right;
      return String(left).localeCompare(String(right), undefined, { numeric: true });
    }

    function makeSortable(table: HTMLTableElement) {
      const head = table.tHead?.rows[0];
      const rowsBody = table.tBodies[0];
      if (!head || !rowsBody) return;

      const headers = Array.from(head.cells);
      let column: number | null = null;
      let direction: 1 | -1 = 1;

      function sortBy(index: number) {
        direction = column === index ? (direction === 1 ? -1 : 1) : 1;
        column = index;

        const rows = Array.from(rowsBody.rows);
        const pinned = rows.filter((row) => row.hasAttribute("data-total"));
        const sortable = rows.filter((row) => !row.hasAttribute("data-total"));

        sortable.sort((left, right) => {
          const a = sortableCellValue(left.cells[index]);
          const b = sortableCellValue(right.cells[index]);
          if (a === null || b === null) {
            if (a === b) return 0;
            return a === null ? 1 : -1;
          }
          return compareValues(a, b) * direction;
        });

        for (const row of sortable) rowsBody.appendChild(row);
        for (const row of pinned) rowsBody.appendChild(row);

        headers.forEach((header, headerIndex) => {
          if (headerIndex === index) {
            header.setAttribute("aria-sort", direction === 1 ? "ascending" : "descending");
          } else {
            header.removeAttribute("aria-sort");
          }
        });
      }

      headers.forEach((header, index) => {
        if (!header.textContent?.trim()) return;
        header.tabIndex = 0;
        header.setAttribute("data-sort-handle", "");
        header.addEventListener("click", () => sortBy(index));
        header.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            sortBy(index);
          }
        });
      });
    }

    document
      .querySelectorAll<HTMLTableElement>("table.report-table[data-sortable]")
      .forEach(makeSortable);

    // Full holdings: fetched once, then filtered and paged in the browser.
    type Holding = {
      stock: string;
      ticker: string;
      country: string;
      country_code: string;
      cap: string;
      weight: string;
      weight_value: number;
      day: number | null;
      direction: string | null;
      region: string;
      sector: string;
    };

    const PAGE_SIZE = 50;
    let allRows: Holding[] = [];
    let filteredRows: Holding[] = [];
    let page = 0;
    let sortKey: keyof Holding = "weight_value";
    let sortDirection: 1 | -1 = -1;
    let loading: Promise<void> | null = null;

    const body = document.getElementById("holdings-body") as HTMLTableSectionElement | null;
    const search = document.getElementById("holdings-search") as HTMLInputElement | null;
    const regionSelect = document.getElementById("holdings-region") as HTMLSelectElement | null;
    const sectorSelect = document.getElementById("holdings-sector") as HTMLSelectElement | null;
    const capSelect = document.getElementById("holdings-cap") as HTMLSelectElement | null;
    const count = document.getElementById("holdings-count");
    const pageLabel = document.getElementById("holdings-page-label");
    const prev = document.getElementById("holdings-prev") as HTMLButtonElement | null;
    const next = document.getElementById("holdings-next") as HTMLButtonElement | null;

    function fillSelect(select: HTMLSelectElement | null, values: string[], label: string) {
      if (!select) return;
      values.forEach((value) => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });
      select.setAttribute("aria-label", label);
    }

    function escapeHtml(value: unknown): string {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return String(value ?? "").replace(/[&<>"']/g, (char) => entities[char] ?? char);
    }

    // Flags come from the flag-icons stylesheet on jsDelivr; only the ISO code is
    // in our payload. Unknown names fall back to plain text.
    function countryFlag(code: string, name: string): string {
      const label = escapeHtml(name);
      if (!/^[A-Za-z]{2}$/.test(code)) return label || "—";
      return `<span class="fi fi-${code.toLowerCase()}" role="img" aria-label="${label}" title="${label}"></span>`;
    }

    function formatDay(row: Holding): string {
      if (row.day === null) return "—";
      const prefix = row.day > 0 ? "+" : "";
      return `${prefix}${row.day.toFixed(2)}%`;
    }

    function dayClass(row: Holding): string {
      if (row.day === null || row.day === 0) return "text-slate-400";
      return row.day > 0 ? "text-emerald-700" : "text-rose-700";
    }

    function renderPage() {
      if (!body) return;
      const start = page * PAGE_SIZE;
      const rows = filteredRows.slice(start, start + PAGE_SIZE);
      body.innerHTML = rows
        .map(
          (row) => `
            <tr>
              <td class="font-medium">${escapeHtml(row.stock)}</td>
              <td><code>${escapeHtml(row.ticker)}</code></td>
              <td>${escapeHtml(row.region)}</td>
              <td>${escapeHtml(row.sector)}</td>
              <td class="whitespace-nowrap">${countryFlag(row.country_code, row.country)}</td>
              <td>${escapeHtml(row.cap)}</td>
              <td class="text-right tabular-nums">${escapeHtml(row.weight)}</td>
              <td class="text-right tabular-nums ${dayClass(row)}">${row.direction === "up" ? "▲" : row.direction === "down" ? "▼" : "•"} ${formatDay(row)}</td>
            </tr>`,
        )
        .join("");

      if (count) {
        count.textContent = `${filteredRows.length.toLocaleString()} of ${allRows.length.toLocaleString()} lines`;
      }
      if (pageLabel) {
        const totalPages = Math.max(1, Math.ceil(filteredRows.length / PAGE_SIZE));
        pageLabel.textContent = `Page ${page + 1} of ${totalPages}`;
      }
      if (prev) prev.disabled = page === 0;
      if (next) next.disabled = start + PAGE_SIZE >= filteredRows.length;
    }

    function applyFilters() {
      const query = (search?.value ?? "").trim().toLowerCase();
      const region = regionSelect?.value ?? "";
      const sector = sectorSelect?.value ?? "";
      const cap = capSelect?.value ?? "";
      filteredRows = allRows.filter((row) => {
        if (region && row.region !== region) return false;
        if (sector && row.sector !== sector) return false;
        if (cap && row.cap !== cap) return false;
        if (!query) return true;
        return `${row.stock} ${row.ticker} ${row.country}`.toLowerCase().includes(query);
      });
      filteredRows.sort((left, right) => {
        const a = left[sortKey];
        const b = right[sortKey];
        if (a === null || a === undefined) return b === null || b === undefined ? 0 : 1;
        if (b === null || b === undefined) return -1;
        if (typeof a === "number" && typeof b === "number") return (a - b) * sortDirection;
        return String(a).localeCompare(String(b)) * sortDirection;
      });
      updateSortIndicators();
      page = 0;
      renderPage();
    }

    async function loadHoldings() {
      if (allRows.length > 0) {
        return;
      }
      if (loading) {
        return loading;
      }
      loading = (async () => {
        try {
          const response = await fetch("/projects/vallmon/holdings.json");
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const payload = (await response.json()) as {
            regions: Array<{
              name: string;
              sectors: Array<{ name: string; rows: Array<Omit<Holding, "region" | "sector">> }>;
            }>;
          };
          allRows = payload.regions.flatMap((region) =>
            region.sectors.flatMap((sector) =>
              sector.rows.map((row) => ({ ...row, region: region.name, sector: sector.name })),
            ),
          );
          const regions = [...new Set(allRows.map((row) => row.region))].sort();
          const sectors = [...new Set(allRows.map((row) => row.sector))].sort();
          const caps = [...new Set(allRows.map((row) => row.cap))].sort();
          fillSelect(regionSelect, regions, "Filter by region");
          fillSelect(sectorSelect, sectors, "Filter by sector");
          fillSelect(capSelect, caps, "Filter by market cap");
          applyFilters();
        } catch (error) {
          if (body) {
            body.innerHTML = `<tr><td colspan="8" class="py-10 text-center text-rose-700">Could not load holdings: ${escapeHtml(String(error))}</td></tr>`;
          }
        } finally {
          loading = null;
        }
      })();
      return loading;
    }

    search?.addEventListener("input", applyFilters);
    regionSelect?.addEventListener("change", applyFilters);
    sectorSelect?.addEventListener("change", applyFilters);
    capSelect?.addEventListener("change", applyFilters);
    prev?.addEventListener("click", () => {
      if (page > 0) {
        page -= 1;
        renderPage();
      }
    });
    next?.addEventListener("click", () => {
      if ((page + 1) * PAGE_SIZE < filteredRows.length) {
        page += 1;
        renderPage();
      }
    });

    function updateSortIndicators() {
      document.querySelectorAll<HTMLElement>("#holdings-table [data-sort]").forEach((header) => {
        if (header.dataset.sort === sortKey) {
          header.setAttribute("aria-sort", sortDirection === 1 ? "ascending" : "descending");
        } else {
          header.removeAttribute("aria-sort");
        }
      });
    }

    document.querySelectorAll<HTMLElement>("#holdings-table [data-sort]").forEach((header) => {
      header.tabIndex = 0;
      const sortHeader = () => {
        const key = header.dataset.sort as keyof Holding;
        sortDirection = sortKey === key ? (sortDirection === 1 ? -1 : 1) : 1;
        sortKey = key;
        applyFilters();
        loadHoldings();
      };
      header.addEventListener("click", sortHeader);
      header.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          sortHeader();
        }
      });
    });

    updateSortIndicators();

    // Everything above is initialised; now honour the incoming hash.
    const initial = window.location.hash.replace("#", "");
    const valid = tabButtons.some((button) => button.dataset.tab === initial);
    showTab(valid ? initial : "monitor", false);
  </script>
  </body>
</html>
