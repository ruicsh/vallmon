---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import report from "../../data/vallmon.json";

const { monitor, portfolio } = report;

const stateLabel = monitor.state ? monitor.state.toLowerCase() : "unknown";
const stateTone =
  stateLabel === "cash"
    ? "border-rose-300 bg-rose-50 text-rose-800"
    : "border-emerald-300 bg-emerald-50 text-emerald-800";

const series = monitor.series;
const recentSeries = series.slice(-90);
const drawdownValues = recentSeries.map((point) => point.drawdown);
const deltaValues = recentSeries
  .map((point) => point.delta_sigma)
  .filter((value): value is number => value !== null);

function linePath(
  values: number[],
  width = 720,
  height = 180,
  pad = 12,
  forceMin?: number,
  forceMax?: number,
): string {
  if (values.length < 2) return "";
  const observedMin = Math.min(...values);
  const observedMax = Math.max(...values);
  const min = forceMin !== undefined ? Math.min(forceMin, observedMin) : observedMin;
  const max = forceMax !== undefined ? Math.max(forceMax, observedMax) : observedMax;
  const span = max - min || 1;
  return values
    .map((value, index) => {
      const x = pad + (index / (values.length - 1)) * (width - 2 * pad);
      const y = height - pad - ((value - min) / span) * (height - 2 * pad);
      return `${index === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}

const drawdownFloor = Math.min(-16, ...drawdownValues);
const drawdownPath = linePath(drawdownValues, 720, 180, 12, drawdownFloor, 0);
const deltaPath = linePath(deltaValues, 720, 120, 10);
const drawdownThresholdY =
  180 - 12 - ((-15 - drawdownFloor) / (0 - drawdownFloor)) * (180 - 24);
const firstSeries = series[0]?.date ?? "";
const lastSeries = series[series.length - 1]?.date ?? "";

function numeric(value: string | undefined): number {
  if (!value) return 0;
  const match = value.replace(/,/g, "").match(/[-+]?\d+(?:\.\d+)?/);
  return match ? Number(match[0]) : 0;
}

function tone(value: string | undefined): string {
  const amount = numeric(value);
  if (amount > 0) return "text-emerald-700";
  if (amount < 0) return "text-rose-700";
  return "text-slate-500";
}

function arrow(direction: string | null | undefined): string {
  if (direction === "up") return "▲";
  if (direction === "down") return "▼";
  return "•";
}

function arrowTone(direction: string | null | undefined): string {
  if (direction === "up") return "text-emerald-700";
  if (direction === "down") return "text-rose-700";
  return "text-slate-400";
}

const regionRows = portfolio.region.rows;
const sectorRows = portfolio.sector.rows;
const capRows = portfolio.market_cap.rows;
const tabs = [
  { id: "monitor", label: "Drawdown monitor" },
  { id: "portfolio", label: "Portfolio" },
  { id: "holdings", label: "All holdings" },
  { id: "method", label: "Method" },
  { id: "backtests", label: "Backtests" },
];
---

<!doctype html>
<html lang="en" class="m-0 w-full">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="A daily drawdown switch monitor and full holdings report for Vanguard's FTSE Global All-Cap ETF (VALL.L)."
    />
    <meta property="og:title" content="VALL Monitor — Rui Costa" />
    <meta
      property="og:description"
      content="A daily drawdown switch monitor and full holdings report for Vanguard's FTSE Global All-Cap ETF (VALL.L)."
    />
    <title>VALL Monitor — Rui Costa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flag-icons@7.6.0/css/flag-icons.min.css"
    />
  </head>
  <body class="m-0 flex w-full flex-col">
  <header class="fixed z-50 flex h-20 w-full items-center justify-center border-b border-slate-200 bg-white">
    <div class="flex h-20 w-full max-w-6xl items-center justify-between px-4">
      <a href="/" class="font-condensed text-2xl uppercase md:text-xl">
        <span class="font-black">Rui</span> Costa
      </a>
      <div class="flex items-center gap-4 text-sm">
        <a class="text-slate-500 hover:text-orange" href="https://github.com/ruicsh/vallmon">GitHub</a>
        <a class="rounded-full border border-slate-300 px-4 py-2 font-condensed font-semibold uppercase hover:border-orange hover:text-orange" href="/">
          ← Back to site
        </a>
      </div>
    </div>
  </header>
  <main class="w-full pb-24">
    <header class="mx-auto w-full max-w-6xl px-4 pt-28 pb-8">
      <p class="font-condensed text-sm font-semibold tracking-[0.2em] text-orange uppercase">
        Project · market monitor
      </p>
      <h1 class="mt-3">VALL Monitor</h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600">
        A daily reading of Vanguard's FTSE Global All-Cap UCITS ETF
        (<span class="font-semibold text-slate-900">VALL.L</span>) and the
        question that matters when spending from it: in a drawdown, sell the
        fund or draw from cash? The same page carries the full 6,980-line
        portfolio and the backtests behind the rule.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
        <span>Updated {monitor.as_of ?? "—"}</span>
        <span aria-hidden="true">·</span>
        <a class="border-b border-slate-300 pb-0.5 hover:text-orange" href="https://github.com/ruicsh/vallmon">
          Source on GitHub
        </a>
        <a class="border-b border-slate-300 pb-0.5 hover:text-orange" href="/projects/vallmon/data/delta_sigma.csv">
          Readings CSV
        </a>
      </div>
      <p class="mt-6 max-w-3xl border-l-2 border-orange pl-4 text-sm text-slate-500">
        A one-day move is noise more often than signal. These pages describe what
        is happening and what the rule says; they are not investment advice.
      </p>
    </header>

    <nav
      class="sticky top-20 z-30 border-y border-slate-200 bg-white/95 backdrop-blur"
      aria-label="Report sections"
      role="tablist"
    >
      <div class="mx-auto flex w-full max-w-6xl gap-1 overflow-x-auto px-2 py-2 sm:px-4">
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              class="report-tab shrink-0 rounded-full px-4 py-2 font-condensed text-sm font-semibold tracking-wide uppercase transition-colors"
              id={`tab-${tab.id}`}
              role="tab"
              data-tab={tab.id}
              aria-controls={`panel-${tab.id}`}
              aria-selected={index === 0 ? "true" : "false"}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </nav>

    <!-- Drawdown monitor -->
    <article id="panel-monitor" data-panel role="tabpanel" aria-labelledby="tab-monitor" class="mx-auto w-full max-w-6xl px-4 pt-10">
      <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
        <div class:list={["rounded-2xl border p-6 sm:p-8", stateTone]}>
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <p class="font-condensed text-sm font-semibold tracking-[0.18em] uppercase">
              Spending state
            </p>
            <p class="text-xs opacity-70">
              since {monitor.since ?? "—"} · {monitor.unchanged_for ?? 0} readings unchanged
            </p>
          </div>
          <p class="mt-3 font-condensed text-5xl font-black uppercase sm:text-6xl">
            {stateLabel}
          </p>
          <p class="mt-2 text-lg">{monitor.action}</p>
          <div class="mt-7">
            <p class="text-sm font-semibold">
              Drawdown {monitor.drawdown?.toFixed(2) ?? "—"}% · switch at -15%
            </p>
            <div class="relative mt-2 h-3 overflow-hidden rounded-full bg-white/70">
              <div
                class="absolute inset-y-0 left-0 rounded-full bg-current opacity-80"
                style={`width: ${Math.min(100, ((monitor.drawdown ?? 0) / -15) * 100)}%`}
              >
              </div>
              <div class="absolute inset-y-0 right-0 w-px bg-current opacity-40"></div>
            </div>
            <div class="mt-1 flex justify-between text-xs font-semibold opacity-60">
              <span>0%</span>
              <span>-15%</span>
            </div>
            <p class="mt-2 text-sm opacity-80">
              {monitor.distance} to the switch · peak {monitor.peak?.value.toFixed(4) ?? "—"} on {monitor.peak?.date ?? "—"}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {
            [
              { label: "Δσ", value: monitor.delta_sigma?.toFixed(2) ?? "—", note: monitor.volatility ?? "" },
              { label: "Realised σ", value: monitor.sigma !== null ? `${monitor.sigma.toFixed(2)}%` : "—", note: "20-day, annualised" },
              { label: "Baseline μ", value: monitor.baseline !== null ? `${monitor.baseline.toFixed(2)}%` : "—", note: "trailing 90-day mean" },
              { label: "Term slope", value: monitor.slope?.toFixed(2) ?? "—", note: monitor.slope_label ?? "" },
              { label: "Latest volume", value: monitor.volume || "—", note: "units" },
              { label: "Δσ range", value: `${monitor.delta_sigma_min?.toFixed(2) ?? "—"}–${monitor.delta_sigma_max?.toFixed(2) ?? "—"}`, note: `median ${monitor.delta_sigma_median?.toFixed(2) ?? "—"}` },
            ].map((metric) => (
              <div class="rounded-xl border border-slate-200 p-4">
                <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{metric.label}</p>
                <p class="mt-1 font-condensed text-2xl font-bold text-slate-900">{metric.value}</p>
                <p class="text-xs text-slate-500">{metric.note}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
        {monitor.window}
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <figure>
          <figcaption class="flex items-baseline justify-between">
            <span class="font-condensed text-lg font-bold uppercase">Drawdown</span>
            <span class="text-xs text-slate-500">{firstSeries} → {lastSeries}</span>
          </figcaption>
          <svg viewBox="0 0 720 180" preserveAspectRatio="none" class="mt-3 h-44 w-full rounded-xl border border-slate-200 bg-white" role="img" aria-label="Drawdown history with the -15% switch threshold">
            <line x1="12" y1={drawdownThresholdY} x2="708" y2={drawdownThresholdY} stroke="#fca5a5" stroke-dasharray="4 4" vector-effect="non-scaling-stroke"></line>
            <text x="708" y={drawdownThresholdY - 4} text-anchor="end" class="fill-rose-500 text-[11px]">-15%</text>
            <path d={drawdownPath} fill="none" stroke="#f17f5a" stroke-width="2" vector-effect="non-scaling-stroke"></path>
          </svg>
        </figure>
        <figure>
          <figcaption class="flex items-baseline justify-between">
            <span class="font-condensed text-lg font-bold uppercase">Rolling Variance Delta</span>
            <span class="text-xs text-slate-500">last {deltaValues.length} readings</span>
          </figcaption>
          <svg viewBox="0 0 720 120" preserveAspectRatio="none" class="mt-3 h-44 w-full rounded-xl border border-slate-200 bg-white" role="img" aria-label="Rolling Variance Delta history">
            <path d={deltaPath} fill="none" stroke="#0f172a" stroke-width="2" vector-effect="non-scaling-stroke"></path>
          </svg>
        </figure>
      </div>

      <div class="mt-10">
        <h2>Recent readings</h2>
        <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200">
          <table class="report-table w-full min-w-[760px] text-sm" data-sortable>
            <thead>
              <tr>
                <th>Date</th>
                <th class="text-right">Close (GBP)</th>
                <th class="text-right">Day</th>
                <th class="text-right">Drawdown</th>
                <th>State</th>
                <th>Signal</th>
                <th class="text-right">Δσ</th>
                <th>Volatility</th>
              </tr>
            </thead>
            <tbody>
              {
                monitor.recent.map((row) => (
                  <tr>
                    <td class="whitespace-nowrap">{row.date}</td>
                    <td class="text-right tabular-nums">{row.close?.toFixed(3)}</td>
                    <td class:list={["text-right tabular-nums", tone(String(row.day))]}>
                      {arrow(row.direction)} {row.day !== null ? `${row.day > 0 ? "+" : ""}${row.day.toFixed(2)}%` : "—"}
                    </td>
                    <td class="text-right tabular-nums text-rose-700">{row.drawdown?.toFixed(2)}%</td>
                    <td class="capitalize">{row.state}</td>
                    <td>{row.signal}</td>
                    <td class="text-right tabular-nums">{row.delta_sigma?.toFixed(2)}</td>
                    <td class="capitalize">
                      <span class="inline-flex items-center gap-2">
                        <img src={`/projects/vallmon/assets/vol-${row.volatility ?? "normal"}.svg`} alt="" width="19" height="12" />
                        {row.volatility}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-slate-500">
          Last {monitor.recent.length} of {monitor.readings} readings. The full series is in the
          <a class="border-b border-slate-300 hover:text-orange" href="/projects/vallmon/data/delta_sigma.csv">CSV</a>.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1fr]">
        <div>
          <h2>Term structure</h2>
          <ul class="mt-4 space-y-3">
            {
              monitor.terms.map((term) => (
                <li class="flex items-center gap-3">
                  <span class="w-10 text-sm text-slate-500">{term.window}d</span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100">
                    <span
                      class="block h-full rounded-full bg-slate-900"
                      style={`width: ${term.sigma !== null ? Math.min(100, (term.sigma / 20) * 100) : 0}%`}
                    />
                  </span>
                  <span class="w-16 text-right text-sm tabular-nums">
                    {term.sigma !== null ? `${term.sigma.toFixed(2)}%` : "—"}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-sm text-slate-500">Annualised realised volatility for 10, 20, 30 and 60 trading-day windows.</p>
        </div>
        <div>
          <h2>Signal history</h2>
          <div class="report-prose mt-4" set:html={monitor.signal_history_html} />
        </div>
      </div>
    </article>

    <!-- Portfolio -->
    <article id="panel-portfolio" data-panel role="tabpanel" aria-labelledby="tab-portfolio" class="mx-auto w-full max-w-6xl px-4 pt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h2>Portfolio — daily moves</h2>
          <p class="mt-1 text-sm text-slate-500">
            Snapshot {portfolio.snapshot ?? "—"} · holdings as of {portfolio.holdings_as_of ?? "—"}
          </p>
        </div>
        <a class="text-sm text-slate-500 underline decoration-slate-300 underline-offset-4 hover:text-orange" href="#holdings" data-jump="holdings">
          Search all 6,980 lines →
        </a>
      </div>
      <p class="mt-2 text-sm text-slate-500">Click any column header to sort the tables below.</p>

      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          portfolio.at_a_glance.map((row) => (
            <div class="rounded-xl border border-slate-200 p-4">
              <dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{row.Metric}</dt>
              <dd class="mt-1 text-lg leading-snug font-semibold text-slate-900">{row.Value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 grid gap-10">
        <div>
          <h3 class="font-condensed text-xl font-bold uppercase">By region</h3>
          <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200">
            <table class="report-table w-full text-sm" data-sortable>
              <thead>
                <tr>
                  {portfolio.region.headers.map((header, index) => <th class:list={[index > 0 && "text-right"]}>{header}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  regionRows.map((row) => (
                    <tr class:list={[row[0] === "Total" && "font-semibold"]} data-total={row[0] === "Total" ? "" : undefined}>
                      <td class="whitespace-nowrap">{row[0]}</td>
                      <td class="text-right tabular-nums">{row[1]}</td>
                      <td class="text-right tabular-nums">
                        <span class="relative inline-block min-w-16">
                          <span class="absolute inset-y-0 left-0 rounded-sm bg-orange/20" style={`width: ${Math.min(100, numeric(row[2]) * 1.5)}%`} />
                          <span class="relative">{row[2]}</span>
                        </span>
                      </td>
                      <td class="text-right tabular-nums">{row[3]}</td>
                      <td class="text-right tabular-nums text-emerald-700">{row[4]}</td>
                      <td class="text-right tabular-nums text-rose-700">{row[5]}</td>
                      <td class="text-right tabular-nums">{row[6]}</td>
                      <td class:list={["text-right tabular-nums", tone(row[7])]}>{row[7]}</td>
                      <td class:list={["text-right font-semibold tabular-nums", tone(row[8])]}>{row[8]}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h3 class="font-condensed text-xl font-bold uppercase">By sector</h3>
          <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200">
            <table class="report-table w-full text-sm" data-sortable>
              <thead>
                <tr>
                  {portfolio.sector.headers.map((header, index) => <th class:list={[index > 0 && "text-right"]}>{header}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  sectorRows.map((row) => (
                    <tr class:list={[row[0] === "Total" && "font-semibold"]} data-total={row[0] === "Total" ? "" : undefined}>
                      <td class="whitespace-nowrap">{row[0]}</td>
                      <td class="text-right tabular-nums">{row[1]}</td>
                      <td class="text-right tabular-nums">
                        <span class="relative inline-block min-w-16">
                          <span class="absolute inset-y-0 left-0 rounded-sm bg-orange/20" style={`width: ${Math.min(100, numeric(row[2]) * 2.5)}%`} />
                          <span class="relative">{row[2]}</span>
                        </span>
                      </td>
                      <td class="text-right tabular-nums">{row[3]}</td>
                      <td class="text-right tabular-nums text-emerald-700">{row[4]}</td>
                      <td class="text-right tabular-nums text-rose-700">{row[5]}</td>
                      <td class="text-right tabular-nums">{row[6]}</td>
                      <td class:list={["text-right tabular-nums", tone(row[7])]}>{row[7]}</td>
                      <td class:list={["text-right font-semibold tabular-nums", tone(row[8])]}>{row[8]}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="mt-10">
        <h3 class="font-condensed text-xl font-bold uppercase">By market cap</h3>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200">
          <table class="report-table w-full max-w-3xl text-sm" data-sortable>
            <thead>
              <tr>{portfolio.market_cap.headers.map((header, index) => <th class:list={[index > 0 && "text-right"]}>{header}</th>)}</tr>
            </thead>
            <tbody>
              {
                capRows.map((row) => (
                  <tr class:list={[row[0] === "Total" && "font-semibold"]} data-total={row[0] === "Total" ? "" : undefined}>
                    <td>{row[0]}</td>
                    <td class="text-right tabular-nums">{row[1]}</td>
                    <td class="text-right tabular-nums">{row[2]}</td>
                    <td class="text-right tabular-nums">{row[3]}</td>
                    <td class="text-right tabular-nums text-emerald-700">{row[4]}</td>
                    <td class="text-right tabular-nums text-rose-700">{row[5]}</td>
                    <td class="text-right tabular-nums">{row[6]}</td>
                    <td class:list={["text-right tabular-nums", tone(row[7])]}>{row[7]}</td>
                    <td class:list={["text-right font-semibold tabular-nums", tone(row[8])]}>{row[8]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-10 grid gap-6">
        <details class="rounded-xl border border-slate-200 p-4">
          <summary class="cursor-pointer font-condensed text-xl font-bold uppercase">Region × market cap</summary>
          <p class="mt-2 text-sm text-slate-500">Weighted one-day move. A dash means the region has no priced line in that cap band.</p>
          <div class="mt-3 overflow-x-auto">
            <table class="report-table w-full text-sm" data-sortable>
              <thead>
                <tr>{portfolio.region_market_cap.headers.map((header, index) => <th class:list={[index > 0 && "text-right"]}>{header}</th>)}</tr>
              </thead>
              <tbody>
                {
                  portfolio.region_market_cap.rows.map((row) => (
                    <tr>
                      {row.map((cell, index) => (
                        <td class:list={[index > 0 && "text-right tabular-nums", index > 0 && tone(cell), index === row.length - 1 && "font-semibold"]}>
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>

        <details class="rounded-xl border border-slate-200 p-4">
          <summary class="cursor-pointer font-condensed text-xl font-bold uppercase">Region × sector</summary>
          <p class="mt-2 text-sm text-slate-500">Weighted one-day move. A dash means the region has no priced line in that sector.</p>
          <div class="mt-3 overflow-x-auto">
            <table class="report-table w-full text-sm" data-sortable>
              <thead>
                <tr>{portfolio.region_sector.headers.map((header, index) => <th class:list={[index > 0 && "text-right"]}>{header}</th>)}</tr>
              </thead>
              <tbody>
                {
                  portfolio.region_sector.rows.map((row) => (
                    <tr>
                      {row.map((cell, index) => (
                        <td class:list={[index > 0 && "text-right tabular-nums", index > 0 && tone(cell), index === row.length - 1 && "font-semibold"]}>
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
